{
  "name": "bowshock",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based compressible CFD for supersonic model rocket aerodynamics, running on WebGPU.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "vitest run --config vitest.gpu.config.ts",
    "check:interface": "node scripts/interface-check.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.0.4",
    "@webgpu/types": "^0.1.74",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
