 void Foam::solvers::shockFluidHeun::prePredictor()
 {
     fluxPredictor();
+
+    // Heun's step: the second pass takes the mean of the two passes' fluxes
+    if (pimple.firstIter())
+    {
+        phi1 = surfaceScalarField::New("phi1", phi_);
+    }
+    else
+    {
+        phi_ = 0.5*(phi1() + phi_);
+    }
+
     correctDensity();
 }
 
