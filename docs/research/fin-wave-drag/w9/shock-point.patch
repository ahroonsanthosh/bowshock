+import { readFileSync, writeFileSync } from 'node:fs';
+import { test } from 'vitest';
+import { hexagonCharacteristics } from '../../src/validation/planar-characteristics';
+
+const DEG = Math.PI / 180;
+type R = { res: number; beta: number; db: number; same: boolean; best: number; firstFloor: number };
+const G = globalThis as unknown as { __shock: R[]; __badTrace?: string[]; __trace?: string[]; __trace0?: number[] };
+
+test('shock', () => {
+  const W = 'docs/research/fin-wave-drag/w9/';
+  type Rec = { key?: string; id?: string; theta: number; bevel: number; mach: number; levels: { N: number; failure?: string }[] };
+  const nodes = readFileSync(W + 'nodes.jsonl', 'utf8').trim().split('\n').map((l) => JSON.parse(l) as Rec);
+  const checks = readFileSync(W + 'checks.jsonl', 'utf8').trim().split('\n').map((l) => JSON.parse(l) as Rec);
+  const failing = [...nodes, ...checks].filter((r) => r.levels.some((l) => l.failure?.includes('shock point')));
+  const passing: Rec[] = [nodes.find((n) => n.key === '10|6|5')!, nodes.find((n) => n.key === '8|6|3')!, nodes.find((n) => n.key === '9|1|6')!];
+  const out: string[] = [
+    "# The shock point's iteration in the method, at the solves that failed it (0009 section 9.14). Generated by the runner that shock-point.patch adds as tests/tmp-w9/shock.test.ts; the patch also adds logging inside shockPoint of src/validation/planar-characteristics.ts (as at 023abba) and changes nothing else. Apply it only to a scratch checkout; run with ONLY=../../../../tests/tmp-w9/shock.test.ts and docs/research/fin-wave-drag/w9/vitest.config.ts.",
+    '',
+    '| case | N | outcome | shock points | the failing point: wave angle (rad) | final residual | its last step | smallest residual the loop reached there | iteration it first fell below 1e-14 | largest final residual of the other points |',
+    '| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |',
+  ];
+  let firstTrace = '';
+  for (const r of [...failing, ...passing]) {
+    const Ns = r.levels.filter((l) => l.failure?.includes('shock point')).map((l) => l.N);
+    for (const N of Ns.length > 0 ? Ns : [256]) {
+      G.__shock = [];
+      G.__badTrace = undefined;
+      G.__trace = [];
+      G.__trace0 = [];
+      let msg = 'solves';
+      try {
+        hexagonCharacteristics(r.mach, r.theta * DEG, r.bevel, N);
+      } catch (e) {
+        msg = (e as Error).message;
+      }
+      const s = G.__shock;
+      const bad = s.find((x) => !(Math.abs(x.res) < 1e-12));
+      const others = s.filter((x) => x !== bad).map((x) => Math.abs(x.res));
+      if (bad && firstTrace === '' && G.__badTrace) firstTrace = G.__badTrace.join(' ');
+      out.push(
+        `| ${(r.key ?? r.id)!.replaceAll("|", "/")} (${r.theta.toFixed(3)} deg, b ${r.bevel.toFixed(4)}, Mach ${r.mach.toFixed(3)}) | ${N} | ${msg} | ${s.length} | ${bad ? bad.beta.toFixed(4) : '-'} | ${bad ? bad.res.toExponential(2) : '-'} | ${bad ? bad.db.toExponential(2) : '-'} | ${bad ? bad.best.toExponential(2) : '-'} | ${bad ? bad.firstFloor : '-'} | ${Math.max(...others).toExponential(2)} |`,
+      );
+    }
+  }
+  out.push('', 'The 60 secant iterates at the first failing point (iteration: wave angle: residual):', '', firstTrace, '');
+  writeFileSync(W + 'shock-point.out', out.join('\n'));
+});
