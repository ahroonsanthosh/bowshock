+/**
+ * farFieldState with each characteristic quantity blended between its
+ * inside and free-stream values by the weight 1/2 + s/2, clipped to [0, 1],
+ * s its speed over (blend times the inside sound speed): the sharp switch
+ * where a speed is near zero (u_n = a at a sonic boundary, as at Mach 1)
+ * made continuous. The entropy and the tangential velocity are blended as
+ * the state they come from.
+ */
+function blendedFarFieldState(
+  inside: Primitive2D,
+  free: Primitive2D,
+  nx: number,
+  ny: number,
+  gamma: number,
+  blend: number,
+): Primitive2D {
+  const g = 2 / (gamma - 1);
+  const aIn = Math.sqrt((gamma * inside.p) / inside.rho);
+  const aFree = Math.sqrt((gamma * free.p) / free.rho);
+  const unIn = inside.u * nx + inside.v * ny;
+  const unFree = free.u * nx + free.v * ny;
+  const weight = (speed: number) => Math.min(Math.max(0.5 + speed / (2 * blend * aIn), 0), 1);
+  const wPlus = weight(unIn + aIn);
+  const wMinus = weight(unIn - aIn);
+  const w0 = weight(unIn);
+  const plus = wPlus * (unIn + g * aIn) + (1 - wPlus) * (unFree + g * aFree);
+  const minus = wMinus * (unIn - g * aIn) + (1 - wMinus) * (unFree - g * aFree);
+  const un = 0.5 * (plus + minus);
+  const a = (plus - minus) / (2 * g);
+  const entropy = w0 * (inside.p / inside.rho ** gamma) + (1 - w0) * (free.p / free.rho ** gamma);
+  const tu = w0 * (inside.u - unIn * nx) + (1 - w0) * (free.u - unFree * nx);
+  const tv = w0 * (inside.v - unIn * ny) + (1 - w0) * (free.v - unFree * ny);
+  const rho = ((a * a) / (gamma * entropy)) ** (1 / (gamma - 1));
+  return { rho, u: tu + un * nx, v: tv + un * ny, p: (rho * a * a) / gamma };
+}
