<?xml version='1.0' encoding='utf-8'?>
<openrocket version="1.10" creator="bowshock test fixture">
  <!-- A sport rocket: a tangent ogive on a 25 mm tube, four trapezoidal fins
       of rounded section at the base, a launch lug, and a motor mount flush
       with the base. Written for bowshock's tests in OpenRocket's format.
       The launch lug is the one external component not represented. -->
  <rocket>
    <name>Sport four-fin</name>
    <id>00000000-0000-4000-8000-000000000101</id>
    <axialoffset method="absolute">0.0</axialoffset>
    <position type="absolute">0.0</position>
    <referencetype>maximum</referencetype>
    <subcomponents>
      <stage>
        <name>Sustainer</name>
        <id>00000000-0000-4000-8000-000000000102</id>
        <subcomponents>
          <nosecone>
            <name>Nose cone</name>
            <id>00000000-0000-4000-8000-000000000103</id>
            <finish>normal</finish>
            <material type="bulk" density="1050.0" group="Plastics">Polystyrene</material>
            <length>0.1</length>
            <thickness>0.002</thickness>
            <shape>ogive</shape>
            <shapeparameter>1.0</shapeparameter>
            <aftradius>0.0125</aftradius>
            <aftshoulderradius>0.0115</aftshoulderradius>
            <aftshoulderlength>0.02</aftshoulderlength>
            <aftshoulderthickness>0.002</aftshoulderthickness>
            <aftshouldercapped>true</aftshouldercapped>
            <isflipped>false</isflipped>
          </nosecone>
          <bodytube>
            <name>Body tube</name>
            <id>00000000-0000-4000-8000-000000000104</id>
            <finish>normal</finish>
            <material type="bulk" density="680.0" group="PaperProducts">Cardboard</material>
            <length>0.35</length>
            <thickness>0.001</thickness>
            <radius>auto 0.0125</radius>
            <subcomponents>
              <launchlug>
                <name>Launch lug</name>
                <id>00000000-0000-4000-8000-000000000105</id>
                <instancecount>1</instancecount>
                <instanceseparation>0.0</instanceseparation>
                <angleoffset method="relative">45.0</angleoffset>
                <radialdirection>45.0</radialdirection>
                <axialoffset method="middle">0.0</axialoffset>
                <position type="middle">0.0</position>
                <finish>normal</finish>
                <material type="bulk" density="680.0" group="PaperProducts">Cardboard</material>
                <radius>0.0035</radius>
                <length>0.035</length>
                <thickness>0.001</thickness>
              </launchlug>
              <trapezoidfinset>
                <name>Fins</name>
                <id>00000000-0000-4000-8000-000000000106</id>
                <instancecount>4</instancecount>
                <fincount>4</fincount>
                <radiusoffset method="surface">0.0</radiusoffset>
                <angleoffset method="relative">0.0</angleoffset>
                <rotation>0.0</rotation>
                <axialoffset method="bottom">0.0</axialoffset>
                <position type="bottom">0.0</position>
                <finish>normal</finish>
                <material type="bulk" density="170.0" group="Woods">Balsa</material>
                <thickness>0.0024</thickness>
                <crosssection>rounded</crosssection>
                <cant>0.0</cant>
                <filletradius>0.0</filletradius>
                <filletmaterial type="bulk" density="680.0" group="PaperProducts">Cardboard</filletmaterial>
                <rootchord>0.06</rootchord>
                <tipchord>0.03</tipchord>
                <sweeplength>0.03</sweeplength>
                <height>0.04</height>
              </trapezoidfinset>
              <innertube>
                <name>Motor mount</name>
                <id>00000000-0000-4000-8000-000000000107</id>
                <axialoffset method="bottom">0.0</axialoffset>
                <position type="bottom">0.0</position>
                <material type="bulk" density="680.0" group="PaperProducts">Cardboard</material>
                <length>0.075</length>
                <radialposition>0.0</radialposition>
                <radialdirection>0.0</radialdirection>
                <outerradius>0.0095</outerradius>
                <thickness>5.0E-4</thickness>
                <clusterconfiguration>single</clusterconfiguration>
                <clusterscale>1.0</clusterscale>
                <clusterrotation>0.0</clusterrotation>
                <motormount>
                  <ignitionevent>automatic</ignitionevent>
                  <ignitiondelay>0.0</ignitiondelay>
                  <overhang>0.0</overhang>
                  <motor configid="00000000-0000-4000-8000-000000000108">
                    <type>single</type>
                    <manufacturer>Estes</manufacturer>
                    <designation>C6</designation>
                    <diameter>0.018</diameter>
                    <length>0.07</length>
                    <delay>5.0</delay>
                  </motor>
                </motormount>
                <subcomponents>
                  <engineblock>
                    <name>Engine block</name>
                    <id>00000000-0000-4000-8000-000000000109</id>
                    <axialoffset method="top">0.0</axialoffset>
                    <position type="top">0.0</position>
                    <material type="bulk" density="680.0" group="PaperProducts">Cardboard</material>
                    <length>0.005</length>
                    <radialposition>0.0</radialposition>
                    <radialdirection>0.0</radialdirection>
                    <outerradius>auto</outerradius>
                    <thickness>0.003</thickness>
                  </engineblock>
                </subcomponents>
              </innertube>
            </subcomponents>
          </bodytube>
        </subcomponents>
      </stage>
    </subcomponents>
  </rocket>
</openrocket>
